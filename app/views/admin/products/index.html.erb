<div class="mx-auto max-w-5xl p-6">
  <div class="mb-6 flex items-center justify-between">
    <h1 class="text-2xl font-semibold text-gray-900">Produtos</h1>
    <%= link_to "Novo produto", new_admin_product_path, class: "rounded bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-700" %>
  </div>

  <%= form_with url: admin_products_path, method: :get, class: "mb-4 flex flex-wrap items-end gap-3" do %>
    <div>
      <label class="block text-xs font-medium text-gray-700">Buscar</label>
      <input type="search" name="search" value="<%= params[:search] %>" class="mt-1 rounded border-gray-300 text-sm shadow-sm">
    </div>
    <div>
      <label class="block text-xs font-medium text-gray-700">Categoria</label>
      <select name="category_id" class="mt-1 rounded border-gray-300 text-sm shadow-sm">
        <option value="">Todas</option>
        <% @categories.each do |category| %>
          <option value="<%= category.id %>" <%= "selected" if params[:category_id] == category.id %>><%= category.name %></option>
        <% end %>
      </select>
    </div>
    <button type="submit" class="rounded border border-gray-300 px-3 py-1.5 text-sm text-gray-700 hover:bg-gray-50">Filtrar</button>
  <% end %>

  <div class="overflow-hidden rounded border border-gray-200">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-4 py-2 text-left text-xs font-medium uppercase text-gray-500">Nome</th>
          <th class="px-4 py-2 text-left text-xs font-medium uppercase text-gray-500">Categoria</th>
          <th class="px-4 py-2 text-left text-xs font-medium uppercase text-gray-500">Preço</th>
          <th class="px-4 py-2 text-left text-xs font-medium uppercase text-gray-500">Estoque</th>
          <th class="px-4 py-2 text-left text-xs font-medium uppercase text-gray-500">Status</th>
          <th class="px-4 py-2"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200 bg-white">
        <% @products.each do |product| %>
          <tr>
            <td class="px-4 py-2 text-sm text-gray-900"><%= link_to product.name, admin_product_path(product), class: "hover:underline" %></td>
            <td class="px-4 py-2 text-sm text-gray-500"><%= product.category.name %></td>
            <td class="px-4 py-2 text-sm text-gray-500"><%= number_to_currency(product.price) %></td>
            <td class="px-4 py-2"><%= render StockBadgeComponent.new(stock_quantity: product.stock_quantity) %></td>
            <td class="px-4 py-2"><%= render StatusBadgeComponent.new(active: product.active) %></td>
            <td class="px-4 py-2 text-right text-sm">
              <%= link_to "Editar", edit_admin_product_path(product), class: "text-gray-600 hover:underline" %>
              <%= button_to "Remover", admin_product_path(product), method: :delete, class: "ml-3 inline text-red-600 hover:underline", form: { data: { turbo_confirm: "Remover este produto?" } } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <% if @products.empty? %>
    <p class="mt-4 text-sm text-gray-500">Nenhum produto encontrado.</p>
  <% end %>
</div>
