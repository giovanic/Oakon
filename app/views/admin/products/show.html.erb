<div class="mx-auto max-w-lg p-6">
  <div class="mb-6 flex items-center justify-between">
    <h1 class="text-2xl font-semibold text-gray-900"><%= @product.name %></h1>
    <div class="flex gap-2">
      <%= render StatusBadgeComponent.new(active: @product.active) %>
      <%= render StockBadgeComponent.new(stock_quantity: @product.stock_quantity) %>
    </div>
  </div>

  <%= render Products::ImageGalleryComponent.new(product: @product) %>

  <dl class="mt-6 space-y-2 text-sm">
    <div>
      <dt class="font-medium text-gray-500">Categoria</dt>
      <dd class="text-gray-900"><%= @product.category.name %></dd>
    </div>
    <div>
      <dt class="font-medium text-gray-500">Preço</dt>
      <dd class="text-gray-900"><%= number_to_currency(@product.price) %></dd>
    </div>
    <div>
      <dt class="font-medium text-gray-500">Descrição</dt>
      <dd class="text-gray-900"><%= @product.description.presence || "—" %></dd>
    </div>
  </dl>

  <div class="mt-6 flex items-center gap-3">
    <%= link_to "Editar", edit_admin_product_path(@product), class: "rounded bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-700" %>
    <%= link_to "Voltar", admin_products_path, class: "text-sm text-gray-600 hover:underline" %>
  </div>
</div>
