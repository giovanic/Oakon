<%= render "admin/shared/error_messages", record: product %>

<%= form_with model: [:admin, product], class: "space-y-4" do |form| %>
  <div>
    <%= form.label :name, "Nome", class: "block text-sm font-medium text-gray-700" %>
    <%= form.text_field :name, class: "mt-1 block w-full rounded border-gray-300 shadow-sm sm:text-sm" %>
  </div>

  <div>
    <%= form.label :slug, "Slug", class: "block text-sm font-medium text-gray-700" %>
    <%= form.text_field :slug, placeholder: "gerado automaticamente se vazio", class: "mt-1 block w-full rounded border-gray-300 shadow-sm sm:text-sm" %>
  </div>

  <div>
    <%= form.label :category_id, "Categoria", class: "block text-sm font-medium text-gray-700" %>
    <%= form.collection_select :category_id, @categories, :id, :name, { prompt: "Selecione" }, class: "mt-1 block w-full rounded border-gray-300 shadow-sm sm:text-sm" %>
  </div>

  <div>
    <%= form.label :description, "Descrição", class: "block text-sm font-medium text-gray-700" %>
    <%= form.text_area :description, rows: 4, class: "mt-1 block w-full rounded border-gray-300 shadow-sm sm:text-sm" %>
  </div>

  <div class="flex gap-4">
    <div>
      <%= form.label :price, "Preço (R$)", class: "block text-sm font-medium text-gray-700" %>
      <%= form.number_field :price, step: "0.01", min: "0.01", class: "mt-1 block w-full rounded border-gray-300 shadow-sm sm:text-sm" %>
    </div>
    <div>
      <%= form.label :stock_quantity, "Estoque", class: "block text-sm font-medium text-gray-700" %>
      <%= form.number_field :stock_quantity, step: "1", min: "0", class: "mt-1 block w-full rounded border-gray-300 shadow-sm sm:text-sm" %>
    </div>
  </div>

  <div class="flex items-center gap-2">
    <%= form.check_box :active, class: "rounded border-gray-300" %>
    <%= form.label :active, "Ativo (visível na loja)", class: "text-sm text-gray-700" %>
  </div>

  <div>
    <%= form.label :images, "Imagens", class: "block text-sm font-medium text-gray-700" %>
    <%= form.file_field :images, multiple: true, accept: "image/*", class: "mt-1 block w-full text-sm" %>
  </div>

  <% if product.persisted? %>
    <div>
      <p class="mb-2 block text-sm font-medium text-gray-700">Imagens atuais</p>
      <%= render Products::ImageGalleryComponent.new(product: product) %>
    </div>
  <% end %>

  <div class="flex items-center gap-3">
    <%= form.submit "Salvar", class: "rounded bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-700" %>
    <%= link_to "Cancelar", admin_products_path, class: "text-sm text-gray-600 hover:underline" %>
  </div>
<% end %>
