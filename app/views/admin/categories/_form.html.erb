<%= render "admin/shared/error_messages", record: category %>

<%= form_with model: [:admin, category], class: "space-y-4" do |form| %>
  <div>
    <%= form.label :name, "Nome", class: "block text-sm font-medium text-gray-700" %>
    <%= form.text_field :name, class: "mt-1 block w-full rounded border-gray-300 shadow-sm sm:text-sm" %>
  </div>

  <div>
    <%= form.label :slug, "Slug", class: "block text-sm font-medium text-gray-700" %>
    <%= form.text_field :slug, placeholder: "gerado automaticamente se vazio", class: "mt-1 block w-full rounded border-gray-300 shadow-sm sm:text-sm" %>
  </div>

  <div class="flex items-center gap-2">
    <%= form.check_box :active, class: "rounded border-gray-300" %>
    <%= form.label :active, "Ativa (visível na loja)", class: "text-sm text-gray-700" %>
  </div>

  <div class="flex items-center gap-3">
    <%= form.submit "Salvar", class: "rounded bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-700" %>
    <%= link_to "Cancelar", admin_categories_path, class: "text-sm text-gray-600 hover:underline" %>
  </div>
<% end %>
