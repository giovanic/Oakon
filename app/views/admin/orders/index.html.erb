<div class="mx-auto max-w-5xl p-6">
  <div class="mb-6 flex items-center justify-between">
    <h1 class="text-2xl font-semibold text-gray-900">Pedidos</h1>
  </div>

  <div class="overflow-hidden rounded border border-gray-200">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-4 py-2 text-left text-xs font-medium uppercase text-gray-500">Pedido</th>
          <th class="px-4 py-2 text-left text-xs font-medium uppercase text-gray-500">Cliente</th>
          <th class="px-4 py-2 text-left text-xs font-medium uppercase text-gray-500">Total</th>
          <th class="px-4 py-2 text-left text-xs font-medium uppercase text-gray-500">Status</th>
          <th class="px-4 py-2 text-left text-xs font-medium uppercase text-gray-500">Data</th>
          <th class="px-4 py-2"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200 bg-white">
        <% @orders.each do |order| %>
          <tr>
            <td class="px-4 py-2 text-sm text-gray-900"><%= link_to order.id, admin_order_path(order), class: "hover:underline" %></td>
            <td class="px-4 py-2 text-sm text-gray-500"><%= order.customer_name.presence || "—" %></td>
            <td class="px-4 py-2 text-sm text-gray-500"><%= number_to_currency(order.total_price) %></td>
            <td class="px-4 py-2"><%= render OrderStatusBadgeComponent.new(status: order.status) %></td>
            <td class="px-4 py-2 text-sm text-gray-500"><%= l(order.created_at, format: :short) %></td>
            <td class="px-4 py-2 text-right text-sm">
              <%= link_to "Ver", admin_order_path(order), class: "text-gray-600 hover:underline" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <% if @orders.empty? %>
    <p class="mt-4 text-sm text-gray-500">Nenhum pedido encontrado.</p>
  <% end %>
</div>
