<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Minha Loja" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# stylesheet_link_tag :app incluiria também active_admin.css — a loja pública não usa o painel administrativo %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <body class="min-h-screen bg-white text-gray-900 dark:bg-gray-950 dark:text-gray-100">
    <header class="border-b border-gray-200 dark:border-gray-800">
      <div class="mx-auto flex max-w-5xl items-center justify-between p-4">
        <%= link_to "Minha Loja", root_path, class: "text-lg font-semibold" %>
        <%= link_to purchase_path, class: "text-sm font-medium hover:underline" do %>
          Carrinho (<%= current_purchase&.total_quantity.to_i %>)
        <% end %>
      </div>
    </header>

    <% if notice.present? %>
      <p class="mx-auto max-w-5xl p-4 text-sm text-green-700 dark:text-green-400"><%= notice %></p>
    <% end %>
    <% if alert.present? %>
      <p class="mx-auto max-w-5xl p-4 text-sm text-red-700 dark:text-red-400"><%= alert %></p>
    <% end %>

    <main class="mx-auto max-w-5xl p-4">
      <%= yield %>
    </main>

    <footer class="mt-12 border-t border-gray-200 p-4 text-center text-sm text-gray-500 dark:border-gray-800 dark:text-gray-400">
      &copy; <%= Date.current.year %> Minha Loja
    </footer>
  </body>
</html>
